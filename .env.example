# =============================================================
# Papagayo Fishing Tours - environment variables
# Copy this file to `.env` and fill in your own values.
# Never commit `.env` to the repository.
# =============================================================

# --- Hero video (client side, public URL) ---
# Full HTTPS URL of the MP4 in Cloudflare R2; leave empty to use the local video.
# Use a custom domain in production, e.g. https://media.example.com/hero-ocean-charter.mp4
# This is public configuration: do not put R2 API credentials here.
# Set this in your hosting environment before building; rebuild after changes.
VITE_HERO_VIDEO_URL=

# --- Booking / reservations (client side) ---
# Business WhatsApp number in international format (digits only or with +).
VITE_WHATSAPP_NUMBER=50686105784

# --- PayPal (client side, public) ---
# Sandbox: get a client id from https://developer.paypal.com/dashboard
VITE_PAYPAL_CLIENT_ID=

# --- PayPal (server side, private - api/paypal) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Use "sandbox" for testing or "live" for production.
PAYPAL_ENVIRONMENT=sandbox

# --- Contact form email delivery (api/contact) ---
# Optional. If set, contact requests are also sent by email via Resend.
# https://resend.com -> API keys
RESEND_API_KEY=
# Destination inbox for contact requests.
CONTACT_EMAIL_TO=info@papagayofishingtours.com
# Sender address must be verified in Resend.
CONTACT_EMAIL_FROM=onboarding@resend.dev
