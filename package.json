{
  "name": "pura-ruta-adventures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-seo-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:admin": "node tests/run-admin-tests.mjs",
    "test:hero": "node tests/hero/media.mjs && playwright test --config tests/hero/playwright.config.ts",
    "test:packages": "node tests/package-settings/database.mjs && playwright test --config tests/package-settings/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:catalog": "node tests/tour-catalog/grouping.mjs && playwright test --config tests/tour-catalog/playwright.config.ts",
    "test:booking-overlap": "node tests/booking-overlap/availability.mjs && node tests/booking-overlap/database.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.1.1",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "^5.6.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^1.2.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^10.12.16",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.280.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.46.6",
    "react-router-dom": "^6.17.0",
    "tailwind-merge": "^1.14.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.4",
    "vite": "^5.2.7"
  }
}
